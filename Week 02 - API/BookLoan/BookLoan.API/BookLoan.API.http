@baseUrl = http://localhost:5195

### Loan book 1 to Grace -> 200 OK

POST {{baseUrl}}/loans
Content-Type: application/json

{
  "bookId": 1,
  "userName": "Grace"
}

### Loan book 1 again -> 400, the book is already on loan

POST {{baseUrl}}/loans
Content-Type: application/json

{
  "bookId": 1,
  "userName": "Linus"
}

### Loan a book that does not exist -> 400, the book does not exist

POST {{baseUrl}}/loans
Content-Type: application/json

{
  "bookId": 99,
  "userName": "Grace"
}

### Loan without a name -> 400, the borrower must have a name

POST {{baseUrl}}/loans
Content-Type: application/json

{
  "bookId": 2,
  "userName": ""
}

### Return book 1 -> 200 OK

POST {{baseUrl}}/returns
Content-Type: application/json

{
  "bookId": 1,
  "userName": "Grace"
}

### Return book 1 again -> 400, the book is not on loan

POST {{baseUrl}}/returns
Content-Type: application/json

{
  "bookId": 1,
  "userName": "Grace"
}

### Return a book that is on loan to somebody else -> 400

POST {{baseUrl}}/returns
Content-Type: application/json

{
  "bookId": 3,
  "userName": "Grace"
}
